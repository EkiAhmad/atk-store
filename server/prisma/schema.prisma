datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Pengguna Sistem (Admin & Kasir)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Hashed with bcrypt
  name      String
  role      String   @default("KASIR") // ADMIN or KASIR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Kategori Produk ATK (Alat Tulis, Kertas & Buku, Map/Folder, dll.)
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// Produk ATK
model Product {
  id          Int               @id @default(autoincrement())
  barcode     String?           @unique
  name        String
  categoryId  Int?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buyPrice    Decimal           @db.Decimal(12, 2)
  sellPrice   Decimal           @db.Decimal(12, 2)
  stock       Int               @default(0)
  minStock    Int               @default(5)
  unit        String            @default("pcs")
  isActive    Boolean           @default(true)
  items       TransactionItem[]
  stockLogs   StockMovement[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([barcode])
  @@index([name])
  @@map("products")
}

// Transaksi Penjualan Kasir
model Transaction {
  id             Int               @id @default(autoincrement())
  invoiceNumber  String            @unique
  date           DateTime          @default(now())
  totalAmount    Decimal           @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal           @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal           @db.Decimal(12, 2)
  paymentMethod  String            @default("CASH") // CASH, QRIS, TRANSFER
  amountPaid     Decimal           @db.Decimal(12, 2)
  changeAmount   Decimal           @default(0) @db.Decimal(12, 2)
  cashierName    String            @default("Kasir Toko")
  notes          String?
  items          TransactionItem[]
  createdAt      DateTime          @default(now())

  @@index([date])
  @@index([invoiceNumber])
  @@map("transactions")
}

// Item Rincian Transaksi
model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  barcode       String?
  price         Decimal     @db.Decimal(12, 2)
  costPrice     Decimal     @db.Decimal(12, 2)
  quantity      Int
  subtotal      Decimal     @db.Decimal(12, 2)

  @@map("transaction_items")
}

// Log Mutasi Stok
model StockMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   // IN_PURCHASE, IN_IMPORT, OUT_SALE, ADJUSTMENT
  quantity    Int      // + or -
  notes       String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@map("stock_movements")
}

// Pengaturan Toko
model StoreSetting {
  id            Int     @id @default(1)
  name          String  @default("TOKO ATK BAROKAH")
  address       String? @default("Jl. KH. Dewantoro No. 1 Rejoso - Nganjuk")
  phone         String? @default("081259878173")
  receiptFooter String? @default("Terima kasih telah berbelanja di TOKO ATK BAROKAH!\nBarang yang sudah dibeli tidak dapat ditukar/dikembalikan.")

  @@map("store_settings")
}
